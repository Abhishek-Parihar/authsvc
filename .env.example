# Server
HOST=0.0.0.0
PORT=8080
ISSUER=http://localhost:8080
ENV=development

# Data stores (Homebrew: brew install postgresql@18 redis && make brew-up)
DATABASE_URL=postgres://authsvc:authsvc@127.0.0.1:5432/authsvc
REDIS_URL=redis://127.0.0.1:6379

# Token TTLs (seconds)
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=604800
SESSION_TTL_SECS=86400

# Security
BOOTSTRAP_SECRET=change-me-on-first-run
# ALLOW_BOOTSTRAP_SECRET=true  # required only if BOOTSTRAP_SECRET is set when ENV=production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_SECS=900
RATE_LIMIT_PER_MINUTE=60
COOKIE_SECURE=false

# Platform model
DEFAULT_ACCOUNT_SLUG=default
DEFAULT_WEBSITE_SLUG=default

# Policy backend: rbac | casbin | openfga
POLICY_BACKEND=rbac
OPENFGA_URL=http://localhost:8081

# Production: set persistent RSA keys (generate with openssl)
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
# DATA_ENCRYPTION_KEY=   # min 32 chars; also accepts MFA_ENCRYPTION_KEY
# KMS_HTTP_URL=          # optional external KMS proxy for data encryption
# JWT_KMS_HTTP_URL=      # optional HTTP KMS for JWT signing (POST /sign)
# JWT_KMS_KEY_ID=        # key id passed to JWT KMS /sign
# DISABLE_PASSWORD_GRANT=true
# DATABASE_MAX_CONNECTIONS=25
# DATABASE_READ_URL=     # optional read replica
# DEPLOYMENT_MODE=self_hosted  # or managed_saas
# AUDIT_EXPORT_WEBHOOK=

# Federated IdPs (optional)
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# Compliance / retention (days)
AUDIT_RETENTION_DAYS=365
DSAR_ARTIFACT_RETENTION_DAYS=30

# Operations
# MIGRATE_ON_START=true          # set false when Helm init container runs migrations
# DATABASE_MIGRATOR_URL=         # superuser/migrator role for audit retention purge
# METRICS_BEARER_TOKEN=          # required when ENV=production

# Notifications (optional)
# SMTP_URL=              # HTTP email relay (SendGrid/Mailgun style)
# SMTP_FROM=authsvc@localhost
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Observability
# OTEL_ENDPOINT=http://localhost:4317
# WEBAUTHN_RP_ID=localhost
RUST_LOG=authsvc_server=debug,tower_http=debug
