# Server
AUTHSVC_HOST=0.0.0.0
AUTHSVC_PORT=8080
AUTHSVC_ISSUER=http://localhost:8080
ENV=development

# Data stores (Homebrew: brew install postgresql@18 redis && make brew-up)
DATABASE_URL=postgres://authsvc:authsvc@127.0.0.1:5432/authsvc
REDIS_URL=redis://127.0.0.1:6379

# Token TTLs (seconds)
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=604800
SESSION_TTL_SECS=86400

# Security
BOOTSTRAP_SECRET=change-me-on-first-run
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_SECS=900
RATE_LIMIT_PER_MINUTE=60
COOKIE_SECURE=false

# Platform model
DEFAULT_ACCOUNT_SLUG=default
DEFAULT_WEBSITE_SLUG=default

# Policy backend: rbac | casbin | openfga
POLICY_BACKEND=rbac
OPENFGA_URL=http://localhost:8081

# Production: set persistent RSA keys (generate with openssl)
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
# MFA_ENCRYPTION_KEY=

# Federated IdPs (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# Observability
# OTEL_ENDPOINT=http://localhost:4317
RUST_LOG=authsvc_server=debug,tower_http=debug
